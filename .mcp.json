{
  "mcpServers": {
    "fal": {
      "type": "http",
      "url": "https://mcp.fal.ai/mcp",
      "headers": {
        "Authorization": "Bearer ${FAL_KEY}"
      }
    },
    "i-am-an-engineer": {
      "command": "uv",
      "args": ["run", "--project", ".", "python", "-m", "i_am_an_engineer.mcp_server"]
    }
  }
}
